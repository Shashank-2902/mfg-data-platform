# Copy this file to .env and change the values. .env is never committed.
POSTGRES_USER=mfg
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mfg

GRAFANA_PASSWORD=change_me

# Telegram: create a bot with @BotFather, then send it a message and read your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Leave as is for the real Telegram. The demo profile points it at a local fake.
TELEGRAM_BASE_URL=https://api.telegram.org

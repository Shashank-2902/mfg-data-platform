{
  "id": "mfgalertflow01",
  "name": "mfg incident alert",
  "active": true,
  "settings": { "executionOrder": "v1" },
  "nodes": [
    {
      "id": "n1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "mfg-incident",
      "parameters": {
        "httpMethod": "POST",
        "path": "incident",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "n2",
      "name": "Open incident",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [240, 300],
      "credentials": { "postgres": { "id": "mfgpostgres01", "name": "mfg Postgres" } },
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH new_incident AS (INSERT INTO incidents (machine_id, incident_type, severity, message, outbox_id) SELECT $1::text, $2::text, $3::text, $4::text, $5::bigint WHERE NOT EXISTS (SELECT 1 FROM incidents WHERE outbox_id = $5::bigint) ON CONFLICT (machine_id, incident_type) WHERE status = 'open' DO NOTHING RETURNING id) SELECT (EXISTS (SELECT 1 FROM new_incident) OR EXISTS (SELECT 1 FROM incidents i JOIN outbox o ON o.id = i.outbox_id WHERE i.outbox_id = $5::bigint AND o.delivered_at IS NULL)) AS send",
        "options": {
          "queryReplacement": "={{ [$json.body.machine_id, $json.body.incident_type, $json.body.severity, $json.body.message, $json.body.outbox_id] }}"
        }
      }
    },
    {
      "id": "n3",
      "name": "Send the message?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.send }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "n4",
      "name": "Switch on severity",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [720, 200],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "leftValue": "={{ $('Webhook').item.json.body.severity }}",
                    "rightValue": "high",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "high"
            }
          ]
        },
        "options": { "fallbackOutput": "extra", "renameFallbackOutput": "other" }
      }
    },
    {
      "id": "n5",
      "name": "Telegram high",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [960, 120],
      "credentials": { "telegramApi": { "id": "mfgtelegram01", "name": "mfg Telegram" } },
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ 'ALERT ' + String($('Webhook').item.json.body.machine_id).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') + ': ' + String($('Webhook').item.json.body.message).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') }}",
        "additionalFields": { "appendAttribution": false, "parse_mode": "HTML" }
      }
    },
    {
      "id": "n6",
      "name": "Telegram other",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [960, 300],
      "credentials": { "telegramApi": { "id": "mfgtelegram01", "name": "mfg Telegram" } },
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ 'Warning ' + String($('Webhook').item.json.body.machine_id).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') + ': ' + String($('Webhook').item.json.body.message).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') }}",
        "additionalFields": { "appendAttribution": false, "parse_mode": "HTML" }
      }
    },
    {
      "id": "n7",
      "name": "Mark outbox delivered",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1200, 300],
      "credentials": { "postgres": { "id": "mfgpostgres01", "name": "mfg Postgres" } },
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE outbox SET delivered_at = now() WHERE id = $1 RETURNING id::text AS id",
        "options": {
          "queryReplacement": "={{ $('Webhook').item.json.body.outbox_id }}"
        }
      }
    },
    {
      "id": "n8",
      "name": "Answer the monitor",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1440, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ delivered: true }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Open incident", "type": "main", "index": 0 }]] },
    "Open incident": { "main": [[{ "node": "Send the message?", "type": "main", "index": 0 }]] },
    "Send the message?": {
      "main": [
        [{ "node": "Switch on severity", "type": "main", "index": 0 }],
        [{ "node": "Mark outbox delivered", "type": "main", "index": 0 }]
      ]
    },
    "Switch on severity": {
      "main": [
        [{ "node": "Telegram high", "type": "main", "index": 0 }],
        [{ "node": "Telegram other", "type": "main", "index": 0 }]
      ]
    },
    "Telegram high": { "main": [[{ "node": "Mark outbox delivered", "type": "main", "index": 0 }]] },
    "Telegram other": { "main": [[{ "node": "Mark outbox delivered", "type": "main", "index": 0 }]] },
    "Mark outbox delivered": { "main": [[{ "node": "Answer the monitor", "type": "main", "index": 0 }]] }
  }
}
